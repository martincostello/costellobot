@implements IUsesLayout<_Layout, LayoutModel>

<div id="admin-content">
  <h1 class="visually-hidden">@(LayoutModel.Title)</h1>
  <div class="container-fluid">
    <h2 class="h3">
      Application Logs
      <span class="fa-solid fa-book" aria-hidden="true"></span>
    </h2>
    <div class="row">
      <div class="col-12">
        <div class="log-console" id="logs" role="log" tabindex="0" aria-label="Application logs">Awaiting logs...</div>
      </div>
    </div>
    <div class="row">
      <div class="form-check form-check-inline ml-3 mt-3">
        <input class="form-check-input" type="checkbox" id="logs-auto-scroll" checked value="true">
        <label class="form-check-label" for="logs-auto-scroll">Auto-scroll</label>
      </div>
    </div>
  </div>
  <hr/>
  <div class="container-fluid">
    <h2 class="h3">
      Webhook Deliveries
      <span id="webhooks-count"></span>
      <span class="fa-solid fa-box-open" aria-hidden="true"></span>
    </h2>
    <div class="row">
      <div class="col-md-4">
        <div class="list-group" id="webhooks-index" role="tablist"></div>
      </div>
      <div class="col-md-8">
        <div class="tab-content" id="webhooks-content"></div>
      </div>
    </div>
  </div>
</div>

@functions {
    public LayoutModel LayoutModel { get; } = new("Administration");
}
